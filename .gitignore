# Secrets - never commit
.env
.env.*
!.env.example
*.pem
*.key

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Model artifacts & run outputs. Everything under artifacts/ is ignored except
# the canonical, immutable artifacts the hosted demo and the regression anchors
# depend on (see artifacts/README.md). Never rebuild these in place.
artifacts/**
!artifacts/.gitkeep
!artifacts/README.md
!artifacts/snapshots/
!artifacts/snapshots/snap-a4c99d5a49a64ffd/
!artifacts/snapshots/snap-a4c99d5a49a64ffd/**
!artifacts/contagion/
!artifacts/contagion/**
!artifacts/structure/
!artifacts/structure/**
runs/
*.pt
*.ckpt

# Local data
*.sqlite
*.db
data/local/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Node and frontend build output
node_modules/
frontend/dist/

# Playwright output (curated screenshots live in docs/screens and are kept)
test-results/
playwright-report/
blob-report/
playwright/.cache/

# personal-use-only demo fonts: kept locally, never committed
fonts/
design/concepts/
