# ---------------------------------------------------------------------------
# Liquidity Contagion Engine - environment template
# Copy to .env and fill in real values. NEVER commit .env.
# ---------------------------------------------------------------------------

# PostgreSQL connection (SQLAlchemy URL).
# Local docker-compose default shown below.
DATABASE_URL=postgresql+psycopg://lce:lce@localhost:5432/lce

# Razorpay API credentials. Obtain from the Razorpay dashboard.
# Test-mode keys are prefixed rzp_test_, live keys rzp_live_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Shared secret configured on the Razorpay webhook endpoint.
# Used for HMAC-SHA256 signature verification of inbound webhooks.
RAZORPAY_WEBHOOK_SECRET=

# Razorpay account / merchant identifier this deployment acts on behalf of.
RAZORPAY_ACCOUNT_ID=

# One of: test | live. Guardrail - the app refuses to start in `live`
# unless LCE_ALLOW_LIVE=true is also set.
RAZORPAY_MODE=test

# PayPal sandbox (developer.paypal.com > Apps & Credentials > Sandbox).
# Sandbox only: PAYPAL_MODE=live and any non-sandbox API host are refused.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Id of the webhook registered for this app's listener URL; used to verify
# inbound webhook signatures.
PAYPAL_WEBHOOK_ID=
PAYPAL_MODE=sandbox
# PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Execution runs in a sandbox currency at one declared scale (units of the
# currency per analytic rupee). 0.00001 = one US dollar per rupee lakh.
# PAYPAL_DEMO_CURRENCY=USD
# PAYPAL_DEMO_SCALE=0.00001
# Ask Keystone: Claude reads the question and calls Keystone's tools. Optional;
# without a key the same tools run from a rule-based reading of the question.
ANTHROPIC_API_KEY=
# LCE_AGENT_MODEL=claude-opus-5-5
# Or OpenRouter's Anthropic-compatible endpoint (Claude or other models):
# OPENROUTER_API_KEY=
# LCE_AGENT_PROVIDER=openrouter   # auto | anthropic | openrouter
# LCE_AGENT_EFFORT=low
# Which provider /execution/status describes: razorpay_test | paypal_sandbox
# LCE_EXECUTION_PROVIDER=razorpay_test

# Directory where trained model artifacts + manifests are persisted.
MODEL_ARTIFACT_DIR=./artifacts

# Global deterministic seed. Every simulation/model run derives its
# per-run seed from this value plus the run's config hash.
RANDOM_SEED=20250101

# ---------------------------------------------------------------------------
# Optional overrides (all have safe defaults; see src/lce/config.py)
# ---------------------------------------------------------------------------
# LCE_ENV=local
# LCE_LOG_LEVEL=INFO
# LCE_LOG_FORMAT=json
# LCE_API_HOST=0.0.0.0
# LCE_API_PORT=8000
# LCE_DB_ECHO=false
# LCE_DB_POOL_SIZE=5
# LCE_ALLOW_LIVE=false
